{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F401",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32F401",
            "interface": "swd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/${command:cmake.buildType}/${workspaceFolderBasename}.elf",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/STM32F401.svd",
            "serverArgs": [
                "-cp",
                "D:/Downloads/STM/STM32_PROG/bin"
            ]
        }
    ]
}